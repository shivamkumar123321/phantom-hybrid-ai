{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "companion",
      "public": "packages/companion/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "demo",
      "public": "packages/demo/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ]
}
