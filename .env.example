# Replace the placeholders with your Firebase project values and load them into the shell
# before building. The build scripts do not load .env automatically.

# Build mode: use production for a deploy build.
NODE_ENV=development

# HTTPS origin of the deployed AI Companion. Leave empty for local browser checks.
COMPANION_ORIGIN=https://studio-6111527342-2c855.web.app

# Firebase web app settings for the AI Companion.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=studio-6111527342-2c855.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studio-6111527342-2c855
VITE_FIREBASE_APP_ID=1:595449873659:web:e8816af59d3bcaab339c5e

# Google Cloud Fraud Defense / reCAPTCHA provider ("enterprise" recommended, or "v3" for Classic) and site key used by Firebase App Check.
VITE_RECAPTCHA_PROVIDER=enterprise
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key

# Local development only. Production builds exclude this value.
FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional local server port. Demo defaults to 5000; AI Companion defaults to 4174.
# Set PORT separately when starting either server on another port.
PORT=5000
